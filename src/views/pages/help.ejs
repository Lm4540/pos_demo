<%- include('../partials/head', { title: 'Manual de Ayuda y Guía de Usuario' }) %>

<style>
  .guide-card img {
    cursor: zoom-in;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .guide-card img:hover {
    transform: scale(1.008);
    opacity: 1 !important;
  }
  .tip-box {
    background: rgba(59, 130, 246, 0.08);
    border-left: 4px solid #3b82f6;
  }
  .alert-box {
    background: rgba(239, 68, 68, 0.08);
    border-left: 4px solid #ef4444;
  }
  .success-box {
    background: rgba(16, 185, 129, 0.08);
    border-left: 4px solid #10b981;
  }
  .warning-box {
    background: rgba(245, 158, 11, 0.08);
    border-left: 4px solid #f59e0b;
  }
</style>

<div class="min-h-screen bg-neutral-950 flex flex-col">
  <!-- Nav Bar -->
  <nav class="bg-neutral-900 border-b border-neutral-800 px-6 py-4 flex items-center justify-between shadow-md">
    <div class="flex items-center gap-3">
      <button type="button" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/dashboard'; }" class="text-neutral-400 hover:text-white transition-colors cursor-pointer" title="Volver atrás">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      </button>
      <div>
        <span class="text-xl font-bold text-white tracking-wide">Manual de Ayuda y Guía del Sistema</span>
        <span class="text-xs block text-neutral-400 font-medium">Instrucciones sencillas paso a paso para todo el personal</span>
      </div>
  </nav>

  <div class="flex-grow max-w-7xl w-full mx-auto p-6 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Sidebar: Search & Categories (4/12 columns) -->
    <aside class="lg:col-span-4 flex flex-col gap-6 h-fit lg:sticky lg:top-6 lg:max-h-[calc(100vh-3rem)] lg:overflow-y-auto pr-1">
      <!-- Search Input -->
      <div class="bg-neutral-900 border border-neutral-800 p-5 rounded-2xl shadow-sm flex flex-col gap-3">
        <label for="search-manual" class="block text-xs font-bold text-neutral-400 uppercase tracking-wider">Buscador Rápido</label>
        <div class="relative">
          <input 
            type="text" 
            id="search-manual" 
            class="w-full pl-9 pr-3 py-2.5 border border-neutral-800 bg-neutral-950 text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm transition-all" 
            placeholder="¿Qué deseas hacer? (ej. abrir caja, cobrar, ordenes...)"
            autocomplete="off">
          <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-neutral-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>
        <p class="text-[10px] text-neutral-500">Escribe cualquier palabra para encontrar la guía de inmediato.</p>
      </div>

      <!-- Categories Tabs -->
      <div class="bg-neutral-900 border border-neutral-800 p-5 rounded-2xl shadow-sm flex flex-col gap-1.5">
        <span class="block text-xs font-bold text-neutral-400 uppercase tracking-wider mb-2">Temas del Manual</span>
        
        <button onclick="filterCategory('all')" id="tab-all" class="tab-btn w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold transition-all bg-blue-600 text-white shadow-md shadow-blue-500/10">
          📂 Mostrar Todo
        </button>
        <button onclick="filterCategory('primeros-pasos')" id="tab-primeros-pasos" class="tab-btn w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-neutral-800 border border-transparent transition-all">
          🟢 Primeros Pasos (Para Principiantes)
        </button>
        <button onclick="filterCategory('caja')" id="tab-caja" class="tab-btn w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-neutral-800 border border-transparent transition-all">
          💰 Control de Caja y Efectivo
        </button>
        <button onclick="filterCategory('ventas')" id="tab-ventas" class="tab-btn w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-neutral-800 border border-transparent transition-all">
          🛒 Ventas y Punto de Cobro (POS)
        </button>
        <button onclick="filterCategory('compras')" id="tab-compras" class="tab-btn w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-neutral-800 border border-transparent transition-all">
          🚚 Compras, Proveedores y Órdenes
        </button>
        <button onclick="filterCategory('gastos')" id="tab-gastos" class="tab-btn w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-neutral-800 border border-transparent transition-all">
          💸 Gastos Operativos
        </button>
        <button onclick="filterCategory('clientes')" id="tab-clientes" class="tab-btn w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-neutral-800 border border-transparent transition-all">
          👥 Clientes y Créditos (Fiado / CXC)
        </button>
        <button onclick="filterCategory('productos')" id="tab-productos" class="tab-btn w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-neutral-800 border border-transparent transition-all">
          📦 Productos, Inventario y Lotes
        </button>
        <button onclick="filterCategory('auditorias')" id="tab-auditorias" class="tab-btn w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-neutral-800 border border-transparent transition-all">
          📊 Levantamiento y Auditoría de Stock
        </button>
        <button onclick="filterCategory('usuarios')" id="tab-usuarios" class="tab-btn w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold text-neutral-400 hover:text-white hover:bg-neutral-800 border border-transparent transition-all">
          🔑 Usuarios, Seguridad y Permisos
        </button>
      </div>
    </aside>

    <!-- Main Content Area: Guides (8/12 columns) -->
    <main class="lg:col-span-8 space-y-8" id="guides-container">
      
      <!-- ==================== PRIMEROS PASOS ==================== -->
      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="primeros-pasos">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-emerald-950 text-emerald-400 border border-emerald-900/60">Primeros Pasos</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: bas-conceptos</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Guía Básica para Principiantes: ¿Cómo usar el sistema?</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>Bienvenido al sistema de punto de venta. Si es tu primera vez usando una computadora o este programa, no te preocupes: el sistema está diseñado para ser muy fácil, intuitivo y seguro.</p>
          
          <div class="tip-box p-4 rounded-xl text-xs space-y-2">
            <strong class="text-blue-300 font-bold block">💡 Conceptos sencillos que debes conocer:</strong>
            <ul class="list-disc list-inside space-y-1.5 text-neutral-300">
              <li><strong>Hacer Clic (Clic izquierdo)</strong>: Es presionar el botón izquierdo del ratón (mouse) sobre cualquier botón o texto de la pantalla para entrar o confirmar.</li>
              <li><strong>Campos de Texto (Recuadros)</strong>: Son las cajas oscuras donde puedes escribir con el teclado (nombres, precios, cantidades). Haz un clic adentro del recuadro para empezar a escribir.</li>
              <li><strong>Botón Volver Atrás (Flecha ←)</strong>: Si entraste a una pantalla por error o quieres regresar a lo que estabas haciendo antes, haz clic en la flecha izquierda <strong class="text-white">←</strong> en la esquina superior izquierda.</li>
              <li><strong>Turno de Caja</strong>: Es como tu "jornada de trabajo". Todo el dinero en efectivo que cobras, gastas o recibes se anota en tu turno para que al final del día sepas exactamente cuánto dinero debes entregar.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="primeros-pasos">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-emerald-950 text-emerald-400 border border-emerald-900/60">Primeros Pasos</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: bas-login</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cómo Iniciar y Cerrar Sesión</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <h4 class="font-bold text-white">1. Iniciar Sesión (Entrar al sistema):</h4>
          <ol class="list-decimal list-inside space-y-1 text-xs pl-2">
            <li>En la pantalla de bienvenida, escribe tu <strong>Nombre de Usuario</strong>.</li>
            <li>Escribe tu <strong>Contraseña</strong> (por seguridad se verá en puntos).</li>
            <li>Haz clic en el botón azul <strong>Iniciar Sesión</strong>.</li>
          </ol>

          <h4 class="font-bold text-white mt-2">2. Cerrar Sesión (Salida segura):</h4>
          <ol class="list-decimal list-inside space-y-1 text-xs pl-2">
            <li>Cuando termines tu jornada o te retires de la computadora, ve a <strong>Mi Perfil</strong> en la esquina superior derecha o al menú lateral.</li>
            <li>Haz clic en el botón rojo <strong>Cerrar Sesión</strong>. Esto evita que otra persona use tu cuenta.</li>
          </ol>
        </div>
      </section>

      <!-- ==================== CONTROL DE CAJA ==================== -->
      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="caja">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-teal-950 text-teal-400 border border-teal-900/60">Control de Caja</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: box-apertura</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cómo abrir la caja al iniciar el día (Fondo Inicial)</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-2">
          <p>Al llegar a la tienda en la mañana o al comenzar tu turno, debes registrar el dinero con el que inicias para dar cambio (llamado <em>sencillo</em> o <em>fondo de apertura</em>):</p>
          <ol class="list-decimal list-inside space-y-1.5 text-xs">
            <li>Si no tienes un turno abierto, el sistema te mostrará automáticamente la pantalla <strong>Apertura de Caja</strong>.</li>
            <li>Selecciona el nombre de tu caja (ej. <em>Caja Principal</em> o <em>Caja 1</em>).</li>
            <li>Revisa o digita el <strong>Monto de Apertura</strong> en dólares (el dinero físico que tienes en la gaveta).</li>
            <li>Haz clic en el botón morado <strong>Abrir Caja</strong>. ¡Listo! Ya puedes empezar a vender.</li>
          </ol>
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="caja">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-teal-950 text-teal-400 border border-teal-900/60">Control de Caja</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: box-saldo-vivo</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Saldo en Caja en Vivo y Estado de Cuenta</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>En la pantalla <strong>Caja</strong> > <strong>Detalles de Caja Activa</strong> (`/cashier/details`), dispones de un panel en tiempo real que te muestra exactamente cuánto dinero en efectivo debe haber en la gaveta:</p>
          
          <div class="success-box p-4 rounded-xl text-xs space-y-2">
            <strong class="text-emerald-300 font-bold block">💵 ¿Cómo se calcula el Saldo en Caja?</strong>
            <p><strong>Saldo Actual =</strong> Fondo Inicial + Ventas en Efectivo + Abonos en Efectivo + Entradas de Sencillo - Retiros / Gastos.</p>
          </div>

          <h4 class="font-bold text-white mt-2">Columna "Saldo Después" en los Movimientos:</h4>
          <p class="text-xs text-neutral-300">En la tabla de historial de movimientos de caja, cada fila te muestra el dinero que entró o salió y la columna <strong class="text-indigo-400">Saldo Después</strong>, indicando exactamente cuánto saldo quedó en la gaveta justo después de esa transacción.</p>
        </div>
        <div class="mt-4 border border-neutral-800 rounded-2xl overflow-hidden bg-neutral-950/40">
          <img src="/images/manual/saldo_caja_en_vivo.png" alt="Pantalla Saldo en Caja en Vivo" class="w-full h-auto object-cover opacity-90 hover:opacity-100 transition-opacity">
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="caja">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-teal-950 text-teal-400 border border-teal-900/60">Control de Caja</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: box-bloqueo-salidas</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Protección contra Salidas que superen el Saldo en Caja</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>Para protegerte de errores humanos y evitar que la caja quede en saldo negativo o con descuadres inexplicables, el sistema cuenta con <strong>validación de seguridad automática</strong>:</p>
          
          <div class="alert-box p-4 rounded-xl text-xs space-y-2">
            <strong class="text-red-300 font-bold block">⛔ Regla de Oro: No puedes sacar dinero que no existe en la gaveta</strong>
            <p>Si intentas registrar un gasto de <strong>$50.00</strong> pero en la caja solo hay <strong>$30.00</strong> en efectivo, el sistema bloqueará la operación y te mostrará una alerta roja informándote el saldo disponible.</p>
          </div>

          <p class="text-xs text-neutral-300">Esta protección se aplica automáticamente en todas las pantallas:</p>
          <ul class="list-disc list-inside space-y-1 text-xs pl-2">
            <li><strong>Gastos Menores</strong> pagados en efectivo.</li>
            <li><strong>Facturas de Compra</strong> pagadas en efectivo.</li>
            <li><strong>Abonos a Proveedores</strong> pagados en efectivo.</li>
            <li><strong>Retiros de Caja</strong> (para remesas a banco o pagos al dueño).</li>
          </ul>
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="caja">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-teal-950 text-teal-400 border border-teal-900/60">Control de Caja</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: box-movimientos</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cómo ingresar cambio extra o retirar dinero de la caja</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-2">
          <p>Durante el día puedes necesitar ingresar más monedas/billetes para cambio o retirar dinero para guardarlo en la caja fuerte:</p>
          <ol class="list-decimal list-inside space-y-1.5 text-xs">
            <li>Entra a <strong>Caja</strong> > <strong>Detalles de Caja Activa</strong>.</li>
            <li>Elige una de las dos opciones:
              - <strong class="text-emerald-400">Ingresar Efectivo</strong>: Si trajeron más cambio a la caja.
              - <strong class="text-red-400">Retirar Efectivo</strong>: Si vas a sacar dinero para resguardo o remesa.
            </li>
            <li>Escribe el monto en dólares y el <strong>Motivo Obligatorio</strong> (ej. <em>"Cambio de billetes de $20 por monedas"</em> o <em>"Retiro para pago de proveedor"</em>).</li>
            <li>Haz clic en <strong>Guardar Movimiento</strong>. El saldo se actualizará al instante.</li>
          </ol>
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="caja">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-teal-950 text-teal-400 border border-teal-900/60">Control de Caja</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: box-cierre</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cómo cerrar el turno y hacer el Arqueo de Caja</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>Al terminar tu turno de trabajo debes contar el dinero físico y cerrar la caja:</p>
          <ol class="list-decimal list-inside space-y-1.5 text-xs">
            <li>Ve a <strong>Caja</strong> > <strong>Detalles de Caja Activa</strong> y haz clic en el botón rojo <strong>Cerrar Turno</strong>.</li>
            <li>Cuenta todos los billetes y monedas que tienes físicamente en la gaveta.</li>
            <li>Escribe ese número en el recuadro <strong>Efectivo Físico Contado</strong>.</li>
            <li>El sistema comparará tu conteo contra lo que se vendió en el día:
              - <span class="text-emerald-400 font-bold">Cuadre Perfecto ($0.00)</span>: El dinero coincide exactamente.
              - <span class="text-red-400 font-bold">Faltante</span>: Hay menos dinero del esperado.
              - <span class="text-blue-400 font-bold">Sobrante</span>: Hay más dinero del registrado.
            </li>
            <li>Haz clic en <strong>Confirmar Cierre</strong>. El turno quedará cerrado y archivado para el supervisor.</li>
          </ol>
        </div>
        <div class="mt-4 border border-neutral-800 rounded-2xl overflow-hidden bg-neutral-950/40">
          <img src="/images/manual/detalle_caja.png" alt="Pantalla Detalle y Cierre de Caja" class="w-full h-auto object-cover opacity-90 hover:opacity-100 transition-opacity">
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="caja">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-teal-950 text-teal-400 border border-teal-900/60">Control de Caja</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: box-historial-fechas</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Historial de Cortes: Cómo ver los arqueos del Mes Pasado o Fechas Anteriores</h2>
        <div class="guide-content text-sm text-neutral-350 space-y-3">
          <p>Los administradores y supervisores pueden revisar cualquier arqueo histórico de caja filtrando por fechas:</p>
          <ol class="list-decimal list-inside space-y-1.5 text-xs">
            <li>Navega a <strong>Caja</strong> > <strong>Historial de Cortes</strong> (`/cashier/history`).</li>
            <li>En la parte superior verás botones de acceso rápido:
              - <strong class="text-indigo-300 bg-indigo-950/80 px-2 py-0.5 rounded border border-indigo-800">📅 Mes Anterior</strong>: Haz 1 clic para cargar inmediatamente todos los turnos y arqueos del mes pasado completo.
              - <strong>Este Mes</strong>: Regresa a los arqueos del mes actual.
              - <strong>Últimos 30 Días</strong> / <strong>Últimos 3 Meses</strong> / <strong>Todo el Historial</strong>.
            </li>
            <li>También puedes seleccionar un intervalo manual usando los calendarios <strong>Fecha Desde</strong> y <strong>Fecha Hasta</strong> y hacer clic en <strong>Filtrar</strong>.</li>
            <li>Las tarjetas resumen (KPIs) te calcularán en automático: Total de turnos, dinero auditado y fondo inicial acumulado en ese período.</li>
          </ol>
        </div>
        <div class="mt-4 border border-neutral-800 rounded-2xl overflow-hidden bg-neutral-950/40">
          <img src="/images/manual/historial_caja_fechas.png" alt="Historial de Cortes con Filtro por Fechas" class="w-full h-auto object-cover opacity-90 hover:opacity-100 transition-opacity">
        </div>
      </section>

      <!-- ==================== VENTAS Y POS TOUCH ==================== -->
      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="ventas">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-violet-950 text-violet-400 border border-violet-900/60">Ventas y POS Touch</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: pos-intro-touch</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Pantalla de Cobro: Conociendo el POS Touch</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>La pantalla de ventas <strong>POS Touch</strong> está diseñada para ser extremadamente rápida y fácil de operar, ya sea tocando con los dedos en una pantalla táctil o usando el mouse y teclado de la computadora.</p>
          
          <div class="tip-box p-4 rounded-xl text-xs space-y-2">
            <strong class="text-blue-300 font-bold block">🖥️ Las 2 partes principales de la pantalla:</strong>
            <ul class="list-disc list-inside space-y-1.5 text-neutral-300">
              <li><strong class="text-white">Panel Izquierdo (El Carrito de Compra)</strong>: Aquí se muestran los productos que vas cobrando al cliente, con sus cantidades, precios unitarios, descuentos y el botón para vaciar la cuenta.</li>
              <li><strong class="text-white">Panel Derecho (Totales y Formas de Pago)</strong>: Muestra en números grandes el total a pagar en dólares ($), el selector de cliente y los botones grandes para elegir cómo paga el cliente (<strong>Efectivo</strong>, <strong>Tarjeta</strong> o <strong>Crédito</strong>).</li>
            </ul>
          </div>
        </div>
        <div class="mt-4 border border-neutral-800 rounded-2xl overflow-hidden bg-neutral-950/40">
          <img src="/images/manual/sales_pos_touch.png" alt="Pantalla Principal POS Touch" class="w-full h-auto object-cover opacity-90 hover:opacity-100 transition-opacity">
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="ventas">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-violet-950 text-violet-400 border border-violet-900/60">Ventas y POS Touch</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: pos-escanear-barras</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cómo escanear productos con la Pistola de Código de Barras</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>Escanear es la forma más rápida de cobrar:</p>
          <ol class="list-decimal list-inside space-y-2 text-xs">
            <li>Toma la pistola lectora láser y apunta la luz roja hacia las barras negras del empaque del producto.</li>
            <li>Presiona el gatillo de la pistola. Escucharás un sonido (*bip*) y el artículo aparecerá automáticamente en la lista de la venta.</li>
            <li><strong class="text-emerald-400">¿Cómo sumar varias unidades rápidamente?</strong> Si el cliente lleva 3 galletas iguales, solo pasa el código 3 veces por el lector. El sistema sumará automáticamente las cantidades sin llenar la pantalla de filas repetidas.</li>
            <li><strong class="text-amber-300">💡 Nota importante</strong>: No necesitas hacer clic en ningún lado antes de escanear. El sistema siempre mantiene listo y activo el lector de códigos de barras para que cobres sin tocar el teclado.</li>
          </ol>
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="ventas">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-violet-950 text-violet-400 border border-violet-900/60">Ventas y POS Touch</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: pos-buscar-manual</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cómo buscar un producto manualmente (Sin código de barras)</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>Si un producto tiene el código arrugado, borrado o no tiene etiqueta (como frutas, verduras o pan), tienes <strong>2 formas sencillas</strong> de buscarlo:</p>
          
          <div class="space-y-3 text-xs">
            <div class="bg-neutral-950/60 border border-neutral-800 p-4 rounded-xl space-y-1.5">
              <strong class="text-emerald-400 text-sm font-bold block">🟢 Opción 1: Buscador rápido por nombre (Recomendado)</strong>
              <p>En la parte superior de la pantalla, haz clic en la casilla que dice <strong class="text-white">"Buscar por nombre..."</strong> y escribe las primeras letras del producto (ejemplo: <em>"leche"</em> o <em>"coca"</em>).</p>
              <p>Aparecerá una lista desplegable con las coincidencias. Haz un clic o toca con tu dedo sobre el producto y se agregará de inmediato al carrito.</p>
            </div>

            <div class="bg-neutral-950/60 border border-neutral-800 p-4 rounded-xl space-y-1.5">
              <strong class="text-blue-400 text-sm font-bold block">🔵 Opción 2: Botón azul "Catálogo"</strong>
              <p>Haz clic en el botón azul <strong class="text-white">Catálogo 🔍</strong> en la parte superior. Se abrirá una ventana grande con botones y fotos de todos los productos organizados por categorías (Bebidas, Abarrotes, Limpieza, etc.).</p>
              <p>Toca la categoría que buscas y presiona la tarjeta del producto para sumarlo a la venta.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="ventas">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-violet-950 text-violet-400 border border-violet-900/60">Ventas y POS Touch</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: pos-servicios</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cómo agregar y cobrar un SERVICIO (Recargas, Fletes, Reparaciones)</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>Los <strong>Servicios</strong> son cobros por actividades intangibles que no usan inventario físico (por ejemplo: recargas telefónicas, fletes de entrega a domicilio, servicio de fotocopias o mano de obra):</p>
          
          <ol class="list-decimal list-inside space-y-1.5 text-xs">
            <li>En el buscador por nombre o en el Catálogo, busca el servicio (ej. <em>"Flete a Domicilio"</em> o <em>"Recarga Telefónica"</em>).</li>
            <li>En la lista verás que tienen una etiqueta morada que dice <strong class="text-violet-400">✦ Servicio</strong>.</li>
            <li>Tócalo para agregarlo al carrito. Los servicios nunca se agotan porque tienen disponibilidad infinita.</li>
            <li>Al agregarlo a la lista de venta, podrás definir libremente su precio o escribir una nota especial (ver la siguiente guía).</li>
          </ol>
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="ventas">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-violet-950 text-violet-400 border border-violet-900/60">Ventas y POS Touch</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: pos-editar-precio-desc</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cómo modificar Cantidad, Precio y Nombre/Nota en el Carrito</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>Una vez que tienes los productos o servicios en el carrito de venta, puedes editarlos fácilmente antes de cobrar:</p>
          
          <div class="space-y-3 text-xs">
            <div class="bg-neutral-950/60 border border-neutral-800 p-3.5 rounded-xl space-y-1">
              <strong class="text-white font-bold block">1. Cambiar la Cantidad:</strong>
              <p>Usa los botones <strong class="text-white bg-neutral-800 px-2 py-0.5 rounded">-</strong> y <strong class="text-white bg-neutral-800 px-2 py-0.5 rounded">+</strong> en la fila del artículo para restar o sumar unidades, o haz clic en el recuadro con el número y escribe la cantidad exacta con el teclado.</p>
            </div>

            <div class="bg-neutral-950/60 border border-neutral-800 p-3.5 rounded-xl space-y-1">
              <strong class="text-amber-400 font-bold block">2. Cambiar el Precio de cobro (Botón 💲 Precio):</strong>
              <p>En los servicios, haz clic en el botón amarillo <strong class="text-amber-400">💲 Precio</strong>. Se abrirá una ventana donde podrás escribir el monto exacto a cobrar en dólares (ej. cambiar $0.00 por $15.00). El total se actualizará inmediatamente.</p>
            </div>

            <div class="bg-neutral-950/60 border border-neutral-800 p-3.5 rounded-xl space-y-1">
              <strong class="text-blue-400 font-bold block">3. Personalizar el Nombre / Nota para el Ticket (Botón ✏️ Desc.):</strong>
              <p>En los servicios, haz clic en el botón azul <strong class="text-blue-400">✏️ Desc.</strong>. Escribe una descripción detallada que saldrá impresa en el ticket del cliente (por ejemplo: <em>"Recarga Tigo al número 7788-9900"</em> o <em>"Flete hacia Colonia Miramonte"</em>).</p>
            </div>

            <div class="bg-neutral-950/60 border border-neutral-800 p-3.5 rounded-xl space-y-1">
              <strong class="text-red-400 font-bold block">4. Quitar un producto del carrito:</strong>
              <p>Haz clic en la <strong class="text-red-500 font-bold">✕</strong> roja que aparece al final de la fila del producto para eliminarlo de la cuenta.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="ventas">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-violet-950 text-violet-400 border border-violet-900/60">Ventas y POS Touch</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: pos-cobro-facil</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cobro en Efectivo fácil y Billetes Rápidos ($1, $5, $10, $20, $50, $100)</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>Para cobrar en efectivo y entregar el cambio exacto sin equivocarte en las matemáticas:</p>
          <ol class="list-decimal list-inside space-y-2 text-xs">
            <li>Verifica el total en la esquina inferior derecha (ej. <strong>TOTAL COMPRA: $14.50</strong>).</li>
            <li>Asegúrate de que esté seleccionado el botón verde <strong class="text-emerald-400">EFECTIVO</strong>.</li>
            <li>En el teclado numérico de la pantalla, verás botones de billetes: <strong>$1</strong>, <strong>$5</strong>, <strong>$10</strong>, <strong>$20</strong>, <strong>$50</strong>, <strong>$100</strong>.</li>
            <li>Toca el billete que el cliente te dio (por ejemplo, si te dio uno de $20, toca el botón <strong>$20</strong>).</li>
            <li>El sistema calculará automáticamente el vuelto en letras grandes: <strong class="text-emerald-400">Cambio: $5.50</strong>.</li>
            <li>Presiona el botón azul grande <strong>Completar Venta</strong>. Se abrirá la gaveta de dinero y saldrá el ticket impreso. Entrega el cambio al cliente y listo.</li>
          </ol>
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="ventas">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-violet-950 text-violet-400 border border-violet-900/60">Ventas y POS Touch</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: pos-impresora-gaveta</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Estado de la Impresora Térmica y Botón para Abrir Gaveta</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>En la barra superior del POS Touch verás el estado de la ticketera y herramientas auxiliares:</p>
          
          <div class="space-y-3 text-xs">
            <div class="bg-neutral-950/60 border border-neutral-800 p-4 rounded-xl space-y-1.5">
              <strong class="text-white font-bold block">🟢 Indicador de Impresora:</strong>
              <ul class="list-disc list-inside space-y-1 text-neutral-300">
                <li><strong class="text-emerald-400">Punto Verde (Impresora Conectada)</strong>: La ticketera térmica está lista. Al completar la venta, los comprobantes saldrán al instante de forma automática.</li>
                <li><strong class="text-red-400">Punto Rojo (Desconectada)</strong>: Si aparece en rojo, verifica:
                  1. Que la impresora esté encendida con el botón frontal.
                  2. Que el cable USB esté bien conectado a la computadora.
                  3. Que tenga papel térmico puesto correctamente.
                  4. En cuanto la conectes, el indicador cambiará a verde automáticamente sin reiniciar nada.
                </li>
              </ul>
            </div>

            <div class="bg-neutral-950/60 border border-neutral-800 p-4 rounded-xl space-y-1.5">
              <strong class="text-amber-400 font-bold block">🗄️ Botón para Abrir el Cajón de Dinero:</strong>
              <p>En la barra superior verás un botón amarillo con el icono de una gaveta. Al presionarlo, el sistema enviará una señal directa para abrir la gaveta del dinero sin necesidad de realizar una venta (muy útil para sacar cambio o acomodar billetes).</p>
            </div>
          </div>
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="ventas">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-violet-950 text-violet-400 border border-violet-900/60">Ventas y POS Touch</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: pos-revertir-ticket</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cómo Anular o Revertir un Ticket de Venta</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>Si un cliente devolvió los productos o el cajero cobró una venta por error y se debe devolver el dinero:</p>
          
          <ol class="list-decimal list-inside space-y-2 text-xs">
            <li>En la barra superior del POS Touch, haz clic en el botón de <strong>Historial 📋</strong> (o entra a `/sales/history`).</li>
            <li>En la lista de ventas del día, busca la transacción por el número de ticket o la hora de cobro.</li>
            <li>Haz clic en el botón rojo <strong>Anular Venta</strong>.</li>
            <li>El sistema te pedirá confirmación de seguridad para evitar anulaciones accidentales.</li>
            <li><strong class="text-emerald-400">¿Qué hace el sistema automáticamente al anular?</strong>
              - Devuelve el dinero en efectivo del cliente, descontándolo del saldo de caja de tu turno.
              - Regresa automáticamente todos los productos al inventario para que el stock vuelva a cuadrar.
              - Marca el ticket con la etiqueta roja <strong class="text-red-400">ANULADA</strong> en el historial para auditoría del dueño o supervisor.
            </li>
          </ol>
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="ventas">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-violet-950 text-violet-400 border border-violet-900/60">Ventas y POS Touch</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: pos-reimprimir</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cómo reimprimir una copia del ticket de venta</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-2">
          <p>Si la impresora se quedó sin papel o el cliente te pide una copia adicional de su comprobante:</p>
          <ol class="list-decimal list-inside space-y-1.5 text-xs">
            <li>Ve a la barra superior del POS y haz clic en el icono de <strong>Historial 📋</strong> (o accede a `/sales/history`).</li>
            <li>Localiza la venta por el número de ticket o la hora.</li>
            <li>Haz clic en el botón de la <strong>Impresora 🖨️ (Reimprimir)</strong>.</li>
            <li>La ticketera volverá a imprimir el comprobante al instante sin abrir ventanas emergentes.</li>
          </ol>
        </div>
        <div class="mt-4 border border-neutral-800 rounded-2xl overflow-hidden bg-neutral-950/40">
          <img src="/images/manual/reimprimir_ticket.png" alt="Reimprimir Ticket de Venta" class="w-full h-auto object-cover opacity-90 hover:opacity-100 transition-opacity">
        </div>
      </section>

      <!-- ==================== COMPRAS Y ÓRDENES ==================== -->
      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="compras">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-amber-950 text-amber-400 border border-amber-900/60">Compras y Proveedores</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: ord-calendario</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Calendario de Órdenes de Compra (Agenda Fácil de Pedidos)</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-3">
          <p>La sección <strong>Compras</strong> > <strong>Órdenes de Compra</strong> (`/purchases/orders`) es una agenda interactiva tipo calendario para anotar tus pedidos futuros a proveedores de manera súper sencilla:</p>
          
          <div class="tip-box p-4 rounded-xl text-xs space-y-2">
            <strong class="text-blue-300 font-bold block">📝 Solo necesitas 5 datos básicos:</strong>
            <ul class="list-disc list-inside space-y-1 text-neutral-300">
              <li><strong>Nombre del Proveedor</strong>: Lo escribes a mano (ej. <em>"Distribuidora San José"</em>).</li>
              <li><strong>Fecha de Compra</strong>: El día que llamaste o pediste el producto.</li>
              <li><strong>Fecha de Recepción</strong>: El día que esperas que llegue el camión o pedido.</li>
              <li><strong>Monto Estimado</strong>: Cuánto se pagará en total ($).</li>
              <li><strong>Estado</strong>: <span class="text-amber-400 font-bold">En espera</span> (pendiente de llegar) o <span class="text-emerald-400 font-bold">Recibido</span>.</li>
            </ul>
          </div>

          <h4 class="font-bold text-white mt-2">¿Cómo cambiar el estado de un pedido?</h4>
          <p class="text-xs text-neutral-300">Cuando el camión llegue a la tienda con la mercadería, busca la tarjeta en el calendario y haz <strong class="text-white">1 solo clic</strong> sobre la pastilla de estado. Cambiará inmediatamente a <span class="text-emerald-400 font-bold">✓ Recibido</span>.</p>
        </div>
        <div class="mt-4 border border-neutral-800 rounded-2xl overflow-hidden bg-neutral-950/40">
          <img src="/images/manual/ordenes_calendario.png" alt="Calendario de Órdenes de Compra" class="w-full h-auto object-cover opacity-90 hover:opacity-100 transition-opacity">
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="compras">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-amber-950 text-amber-400 border border-amber-900/60">Compras y Proveedores</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: cxp-compra</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cómo ingresar una Factura de Compra (Ingreso de Stock)</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-2">
          <p>Cuando recibes mercadería física para sumar existencias a tu inventario:</p>
          <ol class="list-decimal list-inside space-y-1.5 text-xs">
            <li>Ve a <strong>Compras</strong> > <strong>Ingresar Factura de Compra</strong> (`/purchases/new`).</li>
            <li>Selecciona el Proveedor y escribe el Número de Factura.</li>
            <li>Elige el método de pago:
              - <strong>Contado (Efectivo)</strong>: Se descontará del saldo de tu caja del día (validando que haya suficiente dinero).
              - <strong>Crédito</strong>: Creará una cuenta por pagar con el proveedor para abonarle después.
            </li>
            <li>Agrega los productos recibidos, digita la cantidad, el costo de compra, el <strong>Lote</strong> y la <strong>Fecha de Vencimiento</strong>.</li>
            <li>Haz clic en <strong>Registrar Compra</strong>. El stock de tu tienda aumentará al instante.</li>
          </ol>
        </div>
        <div class="mt-4 border border-neutral-800 rounded-2xl overflow-hidden bg-neutral-950/40">
          <img src="/images/manual/registrar_compra.png" alt="Ingresar Factura de Compra" class="w-full h-auto object-cover opacity-90 hover:opacity-100 transition-opacity">
        </div>
      </section>

      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="compras">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-amber-950 text-amber-400 border border-amber-900/60">Compras y Proveedores</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: cxp-abonos</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cuentas por Pagar (CXP) y Abonos a Proveedores</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-2">
          <p>Para pagar facturas pendientes a tus distribuidores:</p>
          <ol class="list-decimal list-inside space-y-1.5 text-xs">
            <li>Entra a <strong>Compras</strong> > <strong>Cuentas por Pagar</strong> (`/purchases/payments`).</li>
            <li>Verás la lista de proveedores con saldo pendiente.</li>
            <li>Haz clic en <strong>Abonar</strong> en la factura que deseas pagar.</li>
            <li>Escribe el monto y elige si pagas en <strong>Efectivo</strong> (se descuenta de tu caja) o por <strong>Transferencia Bancaria</strong>.</li>
            <li>Confirma el pago. La deuda disminuirá en tus registros.</li>
          </ol>
        </div>
      </section>

      <!-- ==================== GASTOS OPERATIVOS ==================== -->
      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="gastos">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
          <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded bg-red-950 text-red-400 border border-red-900/60">Gastos Operativos</span>
          <span class="text-[10px] text-neutral-500 font-mono">ID: gst-registro</span>
        </div>
        <h2 class="guide-title text-2xl font-extrabold text-white">Cómo registrar un Gasto Menor (Caja Chica / Servicios)</h2>
        <div class="guide-content text-sm text-neutral-300 space-y-2">
          <p>Para anotar pagos de luz, agua, bolsas de empaque, transporte o limpieza:</p>
          <ol class="list-decimal list-inside space-y-1.5 text-xs">
            <li>Navega a <strong>Gastos</strong> > <strong>Lista de Gastos</strong> (`/expenses`).</li>
            <li>Haz clic en el botón <strong>Registrar Gasto</strong>.</li>
            <li>Escribe el monto en dólares y una descripción clara (ej. <em>"Pago de flete de mercadería"</em>).</li>
            <li>Selecciona si se pagó en <strong>Efectivo</strong> (se restará de tu caja activa) o por <strong>Transferencia</strong>.</li>
            <li>Haz clic en <strong>Guardar Gasto</strong>.</li>
          </ol>
        </div>
        <div class="mt-4 border border-neutral-800 rounded-2xl overflow-hidden bg-neutral-950/40">
          <img src="/images/manual/registrar_gasto.png" alt="Registrar Gasto Menor" class="w-full h-auto object-cover opacity-90 hover:opacity-100 transition-opacity">
        </div>
      </section>

      <!-- ==================== CLIENTES Y CRÉDITOS ==================== -->
      <section class="guide-card space-y-4 bg-neutral-900 border border-neutral-800 p-6 rounded-3xl shadow-sm" data-category="clientes">
        <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
