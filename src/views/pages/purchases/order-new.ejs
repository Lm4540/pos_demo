<%- include('../../partials/head', { title: title || 'Registrar Pedido' }) %>

<div class="min-h-screen bg-neutral-950 flex flex-col">
  <!-- Nav Bar -->
  <nav class="bg-neutral-900 border-b border-neutral-800 px-6 py-4 flex items-center justify-between shadow-md">
    <div class="flex items-center gap-3">
      <a href="/purchases/orders" class="text-neutral-400 hover:text-white transition-colors">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      </a>
      <div>
        <span class="text-xl font-bold text-white tracking-wide">Registrar Nuevo Pedido a Proveedor</span>
        <span class="text-xs block text-neutral-400 font-medium">Programación de compra y fecha estimada de llegada</span>
      </div>
    </div>
  </nav>

  <main class="flex-grow p-6 max-w-7xl w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Order Form Header & Add Product (5/12) -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Order Header Form -->
      <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-6 shadow-sm space-y-4">
        <h2 class="text-base font-bold text-white mb-2">Datos del Pedido</h2>
        
        <div>
          <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">Proveedor *</label>
          <select id="supplierId" class="w-full px-3 py-2.5 border border-neutral-800 bg-neutral-950 text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
            <option value="">Seleccione un proveedor...</option>
            <% suppliers.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% }) %>
          </select>
        </div>

        <% if (user.roleId === 'admin') { %>
        <div>
          <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">Sucursal de Destino *</label>
          <select id="branchId" class="w-full px-3 py-2.5 border border-neutral-800 bg-neutral-950 text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
            <% branches.forEach(b => { %>
              <option value="<%= b.id %>" <%= user.branchId === b.id ? 'selected' : '' %>><%= b.name %></option>
            <% }) %>
          </select>
        </div>
        <% } %>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">Fecha de Pedido *</label>
            <input type="date" id="orderDate" class="w-full px-3 py-2.5 border border-neutral-800 bg-neutral-950 text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">Fecha Llegada *</label>
            <input type="date" id="expectedDeliveryDate" class="w-full px-3 py-2.5 border border-neutral-800 bg-neutral-950 text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">Notas u Observaciones</label>
          <textarea id="notes" rows="2" class="w-full px-3 py-2 border border-neutral-800 bg-neutral-950 text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs" placeholder="Ej. Pedido semanal de medicamentos..."></textarea>
        </div>
      </div>

      <!-- Add Items Form -->
      <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-6 shadow-sm space-y-4">
        <h2 class="text-base font-bold text-white mb-2">Agregar Producto al Pedido</h2>
        
        <div>
          <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">Seleccionar Producto *</label>
          <div class="relative">
            <input type="text" id="productSearchInput" autocomplete="off" placeholder="Buscar por nombre..." class="w-full px-3 py-2.5 border border-neutral-800 bg-neutral-950 text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
            <div id="productSearchResults" class="absolute left-0 right-0 mt-1 max-h-60 overflow-y-auto bg-neutral-900 border border-neutral-800 rounded-xl shadow-xl z-50 hidden divide-y divide-neutral-850"></div>
            <input type="hidden" id="selectedProductId">
            <input type="hidden" id="selectedProductName">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">Cantidad *</label>
            <input type="number" id="itemQuantity" min="1" value="1" class="w-full px-3 py-2.5 border border-neutral-800 bg-neutral-950 text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">Costo Unitario ($) *</label>
            <input type="number" step="0.01" min="0" id="itemUnitCost" class="w-full px-3 py-2.5 border border-neutral-800 bg-neutral-950 text-white rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="0.00">
          </div>
        </div>

        <button type="button" onclick="addOrderItem()" class="w-full py-2.5 bg-neutral-800 hover:bg-neutral-750 text-white font-bold rounded-xl text-sm transition-all cursor-pointer">
          Añadir a la Lista
        </button>
      </div>
    </div>

    <!-- Items List & Submit (7/12) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-6 shadow-sm flex flex-col min-h-[500px] justify-between">
        <div>
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-base font-bold text-white">Detalle de Productos en el Pedido</h2>
            <span id="items-count-badge" class="px-2.5 py-1 bg-neutral-800 text-neutral-400 rounded-lg text-xs font-bold">0 productos</span>
          </div>

          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-neutral-800 text-left text-sm text-neutral-300">
              <thead>
                <tr class="text-neutral-500 font-semibold uppercase tracking-wider text-xs">
                  <th class="py-3 px-3">Producto</th>
                  <th class="py-3 px-3 text-center">Cantidad</th>
                  <th class="py-3 px-3 text-right">Costo Unit.</th>
                  <th class="py-3 px-3 text-right">Subtotal</th>
                  <th class="py-3 px-3 text-center">Acción</th>
                </tr>
              </thead>
              <tbody id="order-items-tbody" class="divide-y divide-neutral-800">
                <tr>
                  <td colspan="5" class="py-8 text-center text-neutral-500 text-xs">No hay productos agregados al pedido.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="border-t border-neutral-800 pt-4 space-y-4">
          <div class="flex justify-between items-center text-lg font-bold">
            <span class="text-white">TOTAL ESTIMADO:</span>
            <span id="order-total-display" class="font-mono text-2xl text-emerald-400">$0.00</span>
          </div>

          <button type="button" onclick="submitOrder()" class="w-full py-3.5 bg-blue-600 hover:bg-blue-500 text-white font-extrabold rounded-xl text-sm transition-all shadow-md shadow-blue-500/10 cursor-pointer">
            GUARDAR Y PROGRAMAR PEDIDO
          </button>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
  let orderItems = [];
  const rawProducts = <%- JSON.stringify(products) %>;

  // Pre-fill today's date for orderDate
  document.getElementById('orderDate').value = new Date().toISOString().split('T')[0];

  // Default expected delivery date to 3 days from now
  const in3Days = new Date();
  in3Days.setDate(in3Days.getDate() + 3);
  document.getElementById('expectedDeliveryDate').value = in3Days.toISOString().split('T')[0];

  const searchInput = document.getElementById('productSearchInput');
  const resultsDiv = document.getElementById('productSearchResults');

  searchInput.addEventListener('input', (e) => {
    const q = e.target.value.trim().toLowerCase();
    if (q.length < 1) {
      resultsDiv.innerHTML = '';
      resultsDiv.classList.add('hidden');
      return;
    }

    const matches = rawProducts.filter(p => p.name.toLowerCase().includes(q) || (p.barCode && p.barCode.toLowerCase().includes(q)));
    resultsDiv.innerHTML = '';

    if (matches.length > 0) {
      matches.slice(0, 10).forEach(p => {
        const itemDiv = document.createElement('div');
        itemDiv.className = "p-2.5 hover:bg-neutral-800 cursor-pointer text-xs flex justify-between items-center";
        itemDiv.innerHTML = `<strong>${p.name}</strong><span class="text-neutral-400 font-mono">$${parseFloat(p.costPrice || 0).toFixed(2)}</span>`;
        itemDiv.onclick = () => {
          document.getElementById('selectedProductId').value = p.id;
          document.getElementById('selectedProductName').value = p.name;
          document.getElementById('productSearchInput').value = p.name;
          document.getElementById('itemUnitCost').value = parseFloat(p.costPrice || 0).toFixed(2);
          resultsDiv.innerHTML = '';
          resultsDiv.classList.add('hidden');
        };
        resultsDiv.appendChild(itemDiv);
      });
      resultsDiv.classList.remove('hidden');
    } else {
      resultsDiv.innerHTML = '<div class="p-2.5 text-neutral-500 text-xs text-center">Sin resultados</div>';
      resultsDiv.classList.remove('hidden');
    }
  });

  function addOrderItem() {
    const productId = document.getElementById('selectedProductId').value;
    const name = document.getElementById('selectedProductName').value;
    const qty = parseInt(document.getElementById('itemQuantity').value, 10);
    const unitCost = parseFloat(document.getElementById('itemUnitCost').value);

    if (!productId || !name) {
      alert('Seleccione un producto de la lista.');
      return;
    }
    if (isNaN(qty) || qty <= 0) {
      alert('Ingrese una cantidad válida.');
      return;
    }
    if (isNaN(unitCost) || unitCost < 0) {
      alert('Ingrese un costo unitario válido.');
      return;
    }

    const subtotal = qty * unitCost;

    const existing = orderItems.find(i => String(i.productId) === String(productId));
    if (existing) {
      existing.quantity += qty;
      existing.unitCost = unitCost;
      existing.subtotal = existing.quantity * unitCost;
    } else {
      orderItems.push({
        productId,
        name,
        quantity: qty,
        unitCost,
        subtotal
      });
    }

    // Reset input fields
    document.getElementById('selectedProductId').value = '';
    document.getElementById('selectedProductName').value = '';
    document.getElementById('productSearchInput').value = '';
    document.getElementById('itemQuantity').value = '1';
    document.getElementById('itemUnitCost').value = '';

    renderOrderItems();
  }

  function removeOrderItem(index) {
    orderItems.splice(index, 1);
    renderOrderItems();
  }

  function renderOrderItems() {
    const tbody = document.getElementById('order-items-tbody');
    const badge = document.getElementById('items-count-badge');
    const totalDisplay = document.getElementById('order-total-display');

    badge.innerText = `${orderItems.length} productos`;

    if (orderItems.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-neutral-500 text-xs">No hay productos agregados al pedido.</td></tr>`;
      totalDisplay.innerText = '$0.00';
      return;
    }

    let grandTotal = 0;
    tbody.innerHTML = orderItems.map((item, idx) => {
      grandTotal += item.subtotal;
      return `
        <tr class="hover:bg-neutral-950/40">
          <td class="py-3 px-3 font-bold text-white">${item.name}</td>
          <td class="py-3 px-3 text-center font-mono font-bold">${item.quantity}</td>
          <td class="py-3 px-3 text-right font-mono text-neutral-400">$${item.unitCost.toFixed(2)}</td>
          <td class="py-3 px-3 text-right font-mono text-emerald-400 font-bold">$${item.subtotal.toFixed(2)}</td>
          <td class="py-3 px-3 text-center">
            <button onclick="removeOrderItem(${idx})" class="text-red-500 hover:text-red-400 font-bold text-xs cursor-pointer">✕</button>
          </td>
        </tr>
      `;
    }).join('');

    totalDisplay.innerText = `$${grandTotal.toFixed(2)}`;
  }

  async function submitOrder() {
    const supplierId = document.getElementById('supplierId').value;
    const branchSelect = document.getElementById('branchId');
    const branchId = branchSelect ? branchSelect.value : null;
    const orderDate = document.getElementById('orderDate').value;
    const expectedDeliveryDate = document.getElementById('expectedDeliveryDate').value;
    const notes = document.getElementById('notes').value;

    if (!supplierId) {
      alert('Seleccione un proveedor.');
      return;
    }
    if (!orderDate || !expectedDeliveryDate) {
      alert('Seleccione la fecha de pedido y la fecha estimada de llegada.');
      return;
    }
    if (orderItems.length === 0) {
      alert('Agregue al menos un producto al pedido.');
      return;
    }

    try {
      const resp = await fetch('/purchases/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          supplierId,
          branchId,
          orderDate,
          expectedDeliveryDate,
          notes,
          items: orderItems
        })
      });

      const resData = await resp.json();
      if (resData.success) {
        alert('Pedido registrado con éxito.');
        window.location.href = '/purchases/orders';
      } else {
        alert(resData.message || 'Error al guardar pedido.');
      }
    } catch (e) {
      alert('Error de red al registrar el pedido.');
    }
  }
</script>

<%- include('../../partials/foot') %>
