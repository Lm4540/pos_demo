<%- include('../../partials/head', { title: 'Calendario de Órdenes de Compra' }) %>

<div class="min-h-screen bg-neutral-950 flex flex-col">
  <!-- Nav Bar -->
  <nav class="bg-neutral-900 border-b border-neutral-800 px-6 py-4 flex items-center justify-between shadow-md">
    <div class="flex items-center gap-3">
      <button type="button" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/dashboard'; }" class="text-neutral-400 hover:text-white transition-colors cursor-pointer" title="Volver atrás">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      </button>
      <div>
        <span class="text-xl font-bold text-white tracking-wide">Calendario de Órdenes de Compra</span>
        <span class="text-xs block text-neutral-400 font-medium">Anotaciones de pedidos a proveedores y fechas de entrega</span>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <button onclick="openNewOrderModal()" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2.5 rounded-xl text-sm font-semibold transition-all shadow-md shadow-blue-500/10 flex items-center gap-2 cursor-pointer">
        <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <span>Anotar Pedido / Orden</span>
      </button>
    </div>
  </nav>

  <main class="flex-grow p-6 max-w-7xl w-full mx-auto space-y-6">
    
    <!-- KPI Summary Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <!-- Total Anotaciones -->
      <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-4 shadow-sm flex flex-col justify-between">
        <span class="text-[11px] font-bold text-neutral-400 uppercase tracking-wider">Total de Pedidos</span>
        <span class="text-2xl font-black text-white mt-1"><%= stats.totalCount %></span>
        <span class="text-[10px] text-neutral-500 mt-1">Anotaciones registradas</span>
      </div>

      <!-- En Espera -->
      <div class="bg-neutral-900 border border-amber-900/50 rounded-2xl p-4 shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold text-amber-400 uppercase tracking-wider">En Espera</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-950 text-amber-300 border border-amber-800/60"><%= stats.pendingCount %></span>
        </div>
        <span class="text-2xl font-black text-amber-400 mt-1 font-mono">$<%= stats.pendingAmount.toFixed(2) %></span>
        <span class="text-[10px] text-neutral-500 mt-1">Por recibir de proveedores</span>
      </div>

      <!-- Recibidos -->
      <div class="bg-neutral-900 border border-emerald-900/50 rounded-2xl p-4 shadow-sm flex flex-col justify-between">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider">Recibidos</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-950 text-emerald-300 border border-emerald-800/60"><%= stats.receivedCount %></span>
        </div>
        <span class="text-2xl font-black text-emerald-400 mt-1 font-mono">$<%= stats.receivedAmount.toFixed(2) %></span>
        <span class="text-[10px] text-neutral-500 mt-1">Pedidos entregados</span>
      </div>

      <!-- Monto Total -->
      <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-4 shadow-sm flex flex-col justify-between">
        <span class="text-[11px] font-bold text-indigo-400 uppercase tracking-wider">Monto Total Estimado</span>
        <span class="text-2xl font-black text-white mt-1 font-mono">$<%= stats.totalAmount.toFixed(2) %></span>
        <span class="text-[10px] text-neutral-500 mt-1">Suma global de órdenes</span>
      </div>
    </div>

    <!-- Navigation View Switcher (Calendario vs Lista) -->
    <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
      <div class="flex items-center gap-2">
        <button onclick="switchView('calendar')" id="btn-view-calendar" class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 bg-blue-600 text-white cursor-pointer shadow-md shadow-blue-500/10">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Vista Calendario</span>
        </button>
        <button onclick="switchView('list')" id="btn-view-list" class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 bg-neutral-900 border border-neutral-800 text-neutral-400 hover:text-white cursor-pointer">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
          </svg>
          <span>Vista Lista (<%= orders.length %>)</span>
        </button>
      </div>

      <!-- Quick Legend -->
      <div class="hidden sm:flex items-center gap-4 text-xs">
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-amber-500 inline-block shadow-sm shadow-amber-500/30"></span>
          <span class="text-neutral-400">En espera</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block shadow-sm shadow-emerald-500/30"></span>
          <span class="text-neutral-400">Recibido</span>
        </div>
      </div>
    </div>

    <!-- VIEW 1: Interactive Calendar -->
    <div id="calendar-container" class="bg-neutral-900 border border-neutral-800 rounded-2xl p-6 shadow-sm space-y-4">
      <!-- Calendar Header Controls -->
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4 border-b border-neutral-800 pb-4">
        <div class="flex items-center gap-3">
          <button onclick="prevMonth()" class="p-2.5 bg-neutral-950 border border-neutral-800 hover:bg-neutral-800 text-white rounded-xl transition-all cursor-pointer">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <h2 id="calendar-title" class="text-lg font-black text-white min-w-[200px] text-center tracking-wide uppercase font-mono"></h2>
          <button onclick="nextMonth()" class="p-2.5 bg-neutral-950 border border-neutral-800 hover:bg-neutral-800 text-white rounded-xl transition-all cursor-pointer">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </button>
          <button onclick="goToCurrentMonth()" class="px-3.5 py-1.5 bg-neutral-950 border border-neutral-800 hover:bg-neutral-800 text-neutral-300 text-xs font-bold rounded-xl transition-all cursor-pointer ml-1">
            Hoy
          </button>
        </div>

        <div class="text-xs text-neutral-400 flex items-center gap-2">
          <span>💡 Haga clic en cualquier fecha para anotar un pedido rápidamente.</span>
        </div>
      </div>

      <!-- Days of Week Header -->
      <div class="grid grid-cols-7 gap-1.5 text-center font-bold text-xs uppercase tracking-wider text-neutral-500 py-1">
        <div>Dom</div>
        <div>Lun</div>
        <div>Mar</div>
        <div>Mié</div>
        <div>Jue</div>
        <div>Vie</div>
        <div>Sáb</div>
      </div>

      <!-- Calendar Month Days Grid -->
      <div id="calendar-grid" class="grid grid-cols-7 gap-1.5 min-h-[500px]">
        <!-- Rendered by JavaScript -->
      </div>
    </div>

    <!-- VIEW 2: List View -->
    <div id="list-container" class="hidden bg-neutral-900 border border-neutral-800 rounded-2xl p-6 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-3">
        <div class="relative w-full sm:w-80">
          <input type="text" id="filter-search" oninput="filterOrdersList()" placeholder="Buscar por proveedor o notas..." class="w-full pl-9 pr-4 py-2 bg-neutral-950 border border-neutral-800 text-white rounded-xl text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <svg class="h-4 w-4 text-neutral-500 absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>

        <div class="flex items-center gap-2 w-full sm:w-auto">
          <select id="filter-status" onchange="filterOrdersList()" class="px-3 py-2 bg-neutral-950 border border-neutral-800 text-white rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="all">Todos los estados</option>
            <option value="pending">En espera</option>
            <option value="received">Recibido</option>
          </select>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-neutral-800 text-left text-sm text-neutral-300">
          <thead>
            <tr class="text-neutral-500 font-semibold uppercase tracking-wider text-xs">
              <th class="py-3 px-4">Proveedor</th>
              <th class="py-3 px-4">Fecha Compra</th>
              <th class="py-3 px-4">Fecha Recepción</th>
              <th class="py-3 px-4">Estado</th>
              <th class="py-3 px-4 text-right">Monto ($)</th>
              <th class="py-3 px-4 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="orders-table-body" class="divide-y divide-neutral-800">
            <% if (orders.length === 0) { %>
            <tr>
              <td colspan="6" class="py-12 text-center text-neutral-500 text-xs">No hay anotaciones de órdenes registradas aún.</td>
            </tr>
            <% } else { %>
            <% orders.forEach(o => { %>
            <% const name = o.supplierName || (o.supplier ? o.supplier.name : 'Sin nombre'); %>
            <tr class="hover:bg-neutral-950/40 transition-colors order-row" data-name="<%= name.toLowerCase() %>" data-notes="<%= (o.notes || '').toLowerCase() %>" data-status="<%= o.status %>">
              <td class="py-3.5 px-4 font-bold text-white">
                <span class="block"><%= name %></span>
                <% if (o.notes) { %>
                <span class="text-[11px] text-neutral-500 font-normal block mt-0.5"><%= o.notes %></span>
                <% } %>
              </td>
              <td class="py-3.5 px-4 font-mono text-xs text-neutral-300"><%= o.orderDate %></td>
              <td class="py-3.5 px-4 font-mono text-xs text-neutral-300">
                <span class="font-bold <%= o.status === 'received' ? 'text-emerald-400' : 'text-amber-400' %>"><%= o.expectedDeliveryDate %></span>
              </td>
              <td class="py-3.5 px-4">
                <button onclick="toggleOrderStatus(<%= o.id %>)" class="cursor-pointer inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold uppercase transition-all <%= o.status === 'received' ? 'bg-emerald-950 text-emerald-400 border border-emerald-800/60 hover:bg-emerald-900/60' : 'bg-amber-950 text-amber-400 border border-amber-800/60 hover:bg-amber-900/60' %>">
                  <span><%= o.status === 'received' ? '✓ Recibido' : '⏳ En espera' %></span>
                </button>
              </td>
              <td class="py-3.5 px-4 text-right font-mono font-bold text-white text-sm">
                $<%= parseFloat(o.totalAmount || 0).toFixed(2) %>
              </td>
              <td class="py-3.5 px-4 text-right space-x-2">
                <button onclick="openEditOrderModal(<%= JSON.stringify(o) %>)" class="text-blue-400 hover:text-blue-300 text-xs font-semibold cursor-pointer">
                  Editar
                </button>
                <button onclick="confirmDeleteOrder(<%= o.id %>)" class="text-red-400 hover:text-red-300 text-xs font-semibold cursor-pointer">
                  Eliminar
                </button>
              </td>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<!-- ================= MODAL: NUEVA ANOTACIÓN DE COMPRA ================= -->
<div id="modal-order" class="fixed inset-0 bg-neutral-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4 z-50 transition-opacity">
  <div class="bg-neutral-900 border border-neutral-800 w-full max-w-lg p-6 rounded-2xl shadow-2xl relative space-y-4">
    <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
      <h3 id="modal-order-title" class="text-base font-bold text-white flex items-center gap-2">
        <svg class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <span>Nueva Anotación de Compra</span>
      </h3>
      <button onclick="closeOrderModal()" class="text-neutral-500 hover:text-white cursor-pointer transition-colors text-lg font-bold">
        ✕
      </button>
    </div>

    <form id="form-order" onsubmit="submitOrderForm(event)" class="space-y-4">
      <input type="hidden" id="order-id" value="">

      <!-- Proveedor Escrito a Mano -->
      <div>
        <label for="order-supplierName" class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">
          Nombre del Proveedor (Escrito a mano) *
        </label>
        <input type="text" id="order-supplierName" required placeholder="Ej. Lácteos La Granja, Distribuidora Santa Ana, Don Juan..." class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-4 py-2.5 text-white text-sm focus:border-blue-500 focus:outline-none transition-all">
      </div>

      <!-- Fechas: Compra y Recepción -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="order-orderDate" class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">
            Fecha de Compra / Pedido *
          </label>
          <input type="date" id="order-orderDate" required class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-3 py-2.5 text-white text-xs focus:border-blue-500 focus:outline-none transition-all">
        </div>
        <div>
          <label for="order-expectedDeliveryDate" class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">
            Fecha de Recepción *
          </label>
          <input type="date" id="order-expectedDeliveryDate" required class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-3 py-2.5 text-white text-xs focus:border-blue-500 focus:outline-none transition-all">
        </div>
      </div>

      <!-- Estado y Monto -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="order-status" class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">
            Estado *
          </label>
          <select id="order-status" required class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-3 py-2.5 text-white text-xs focus:border-blue-500 focus:outline-none transition-all">
            <option value="pending">⏳ En espera (Pendiente)</option>
            <option value="received">✓ Recibido</option>
          </select>
        </div>
        <div>
          <label for="order-amount" class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">
            Monto ($ USD) *
          </label>
          <input type="number" id="order-amount" step="0.01" min="0" required placeholder="0.00" class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-3 py-2.5 text-white text-xs font-mono focus:border-blue-500 focus:outline-none transition-all">
        </div>
      </div>

      <!-- Notas adicionales -->
      <div>
        <label for="order-notes" class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">
          Notas / Observaciones (Opcional)
        </label>
        <input type="text" id="order-notes" placeholder="Ej. Traer 5 cajas de leche, llamar al chofer..." class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-4 py-2 text-white text-xs focus:border-blue-500 focus:outline-none transition-all">
      </div>

      <!-- Actions -->
      <div class="flex items-center justify-between pt-4 border-t border-neutral-800">
        <button type="button" id="btn-delete-order" onclick="deleteCurrentOrder()" class="hidden px-3.5 py-2 text-xs font-bold text-red-400 bg-red-950/40 border border-red-900/60 hover:bg-red-900/60 rounded-xl transition-all cursor-pointer">
          Eliminar
        </button>
        <div class="flex items-center gap-2 ml-auto">
          <button type="button" onclick="closeOrderModal()" class="px-4 py-2 text-xs font-semibold text-neutral-400 bg-neutral-800 hover:bg-neutral-750 rounded-xl transition-all cursor-pointer">
            Cancelar
          </button>
          <button type="submit" id="btn-submit-order" class="px-5 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-500 rounded-xl transition-all shadow-md shadow-blue-500/10 cursor-pointer">
            Guardar Anotación
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  // Initial dataset passed from controller
  let allOrders = <%- JSON.stringify(orders) %>;
  let currentYear = new Date().getFullYear();
  let currentMonth = new Date().getMonth(); // 0-indexed

  const monthNames = [
    'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
    'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
  ];

  // --- VIEW SWITCHER ---
  function switchView(view) {
    const calContainer = document.getElementById('calendar-container');
    const listContainer = document.getElementById('list-container');
    const btnCal = document.getElementById('btn-view-calendar');
    const btnList = document.getElementById('btn-view-list');

    if (view === 'calendar') {
      calContainer.classList.remove('hidden');
      listContainer.classList.add('hidden');
      btnCal.className = "px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 bg-blue-600 text-white cursor-pointer shadow-md shadow-blue-500/10";
      btnList.className = "px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 bg-neutral-900 border border-neutral-800 text-neutral-400 hover:text-white cursor-pointer";
      renderCalendar();
    } else {
      calContainer.classList.add('hidden');
      listContainer.classList.remove('hidden');
      btnList.className = "px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 bg-blue-600 text-white cursor-pointer shadow-md shadow-blue-500/10";
      btnCal.className = "px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 bg-neutral-900 border border-neutral-800 text-neutral-400 hover:text-white cursor-pointer";
    }
  }

  // --- CALENDAR LOGIC ---
  function renderCalendar() {
    const titleEl = document.getElementById('calendar-title');
    const gridEl = document.getElementById('calendar-grid');

    titleEl.textContent = `${monthNames[currentMonth]} ${currentYear}`;
    gridEl.innerHTML = '';

    // First day of month and total days in month
    const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay(); // 0 = Sunday
    const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();
    const prevMonthTotalDays = new Date(currentYear, currentMonth, 0).getDate();

    const todayStr = new Date().toISOString().split('T')[0];

    // Padding cells from previous month
    for (let i = firstDayIndex - 1; i >= 0; i--) {
      const prevDay = prevMonthTotalDays - i;
      const cell = document.createElement('div');
      cell.className = "bg-neutral-950/40 border border-neutral-800/40 rounded-xl p-2 min-h-[90px] opacity-40 flex flex-col justify-between";
      cell.innerHTML = `<span class="text-xs font-mono text-neutral-600">${prevDay}</span>`;
      gridEl.appendChild(cell);
    }

    // Days of current month
    for (let day = 1; day <= totalDays; day++) {
      const monthStr = String(currentMonth + 1).padStart(2, '0');
      const dayStr = String(day).padStart(2, '0');
      const dateKey = `${currentYear}-${monthStr}-${dayStr}`;
      const isToday = dateKey === todayStr;

      // Find orders matching this date (either orderDate or expectedDeliveryDate)
      const dayOrders = allOrders.filter(o => o.expectedDeliveryDate === dateKey || (!o.expectedDeliveryDate && o.orderDate === dateKey));

      const cell = document.createElement('div');
      cell.className = `group bg-neutral-950 border ${isToday ? 'border-blue-500/80 shadow-md shadow-blue-500/10' : 'border-neutral-800'} hover:border-neutral-700 rounded-xl p-2 min-h-[100px] flex flex-col transition-all cursor-pointer`;
      cell.onclick = (e) => {
        if (!e.target.closest('.order-badge-item')) {
          openNewOrderModal(dateKey);
        }
      };

      let badgesHtml = '';
      if (dayOrders.length > 0) {
        badgesHtml = dayOrders.map(o => {
          const name = o.supplierName || (o.supplier ? o.supplier.name : 'Proveedor');
          const isReceived = o.status === 'received';
          const badgeClass = isReceived 
            ? 'bg-emerald-950 text-emerald-300 border-emerald-800/60 hover:bg-emerald-900' 
            : 'bg-amber-950 text-amber-300 border-amber-800/60 hover:bg-amber-900';
          const icon = isReceived ? '✓' : '⏳';
          
          return `
            <div class="order-badge-item text-[11px] font-semibold px-2 py-1 rounded-lg border ${badgeClass} truncate cursor-pointer transition-all shadow-sm flex items-center justify-between gap-1"
                 onclick="event.stopPropagation(); openEditOrderModalById(${o.id})"
                 title="${name} ($${parseFloat(o.totalAmount || 0).toFixed(2)}) - ${isReceived ? 'Recibido' : 'En espera'}">
              <span class="truncate">${icon} ${name}</span>
              <span class="font-mono font-bold text-[10px]">$${parseFloat(o.totalAmount || 0).toFixed(0)}</span>
            </div>
          `;
        }).join('');
      }

      cell.innerHTML = `
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-xs font-mono font-bold ${isToday ? 'bg-blue-600 text-white px-1.5 py-0.5 rounded-md' : 'text-neutral-400'}">${day}</span>
          <button type="button" onclick="event.stopPropagation(); openNewOrderModal('${dateKey}')" class="opacity-0 group-hover:opacity-100 text-[10px] text-blue-400 hover:text-white transition-opacity px-1 rounded hover:bg-neutral-800" title="Anotar en esta fecha">+</button>
        </div>
        <div class="space-y-1 overflow-y-auto max-h-[85px] pr-0.5">
          ${badgesHtml}
        </div>
      `;

      gridEl.appendChild(cell);
    }

    // Remaining padding cells for next month
    const totalRendered = firstDayIndex + totalDays;
    const remaining = (7 - (totalRendered % 7)) % 7;
    for (let i = 1; i <= remaining; i++) {
      const cell = document.createElement('div');
      cell.className = "bg-neutral-950/40 border border-neutral-800/40 rounded-xl p-2 min-h-[90px] opacity-40 flex flex-col justify-between";
      cell.innerHTML = `<span class="text-xs font-mono text-neutral-600">${i}</span>`;
      gridEl.appendChild(cell);
    }
  }

  function prevMonth() {
    currentMonth--;
    if (currentMonth < 0) {
      currentMonth = 11;
      currentYear--;
    }
    renderCalendar();
  }

  function nextMonth() {
    currentMonth++;
    if (currentMonth > 11) {
      currentMonth = 0;
      currentYear++;
    }
    renderCalendar();
  }

  function goToCurrentMonth() {
    const d = new Date();
    currentYear = d.getFullYear();
    currentMonth = d.getMonth();
    renderCalendar();
  }

  // --- MODAL & FORM LOGIC ---
  function openNewOrderModal(defaultDate) {
    const today = defaultDate || new Date().toISOString().split('T')[0];

    document.getElementById('modal-order-title').querySelector('span').textContent = 'Nueva Anotación de Compra';
    document.getElementById('order-id').value = '';
    document.getElementById('order-supplierName').value = '';
    document.getElementById('order-orderDate').value = today;
    document.getElementById('order-expectedDeliveryDate').value = today;
    document.getElementById('order-status').value = 'pending';
    document.getElementById('order-amount').value = '';
    document.getElementById('order-notes').value = '';
    document.getElementById('btn-delete-order').classList.add('hidden');
    document.getElementById('btn-submit-order').textContent = 'Guardar Anotación';

    document.getElementById('modal-order').classList.remove('hidden');
    document.getElementById('order-supplierName').focus();
  }

  function openEditOrderModal(order) {
    document.getElementById('modal-order-title').querySelector('span').textContent = 'Editar Anotación de Compra';
    document.getElementById('order-id').value = order.id;
    document.getElementById('order-supplierName').value = order.supplierName || (order.supplier ? order.supplier.name : '');
    document.getElementById('order-orderDate').value = order.orderDate;
    document.getElementById('order-expectedDeliveryDate').value = order.expectedDeliveryDate || order.orderDate;
    document.getElementById('order-status').value = order.status;
    document.getElementById('order-amount').value = parseFloat(order.totalAmount || 0).toFixed(2);
    document.getElementById('order-notes').value = order.notes || '';
    document.getElementById('btn-delete-order').classList.remove('hidden');
    document.getElementById('btn-submit-order').textContent = 'Actualizar Anotación';

    document.getElementById('modal-order').classList.remove('hidden');
  }

  function openEditOrderModalById(orderId) {
    const order = allOrders.find(o => o.id === orderId);
    if (order) {
      openEditOrderModal(order);
    }
  }

  function closeOrderModal() {
    document.getElementById('modal-order').classList.add('hidden');
  }

  async function submitOrderForm(e) {
    e.preventDefault();

    const orderId = document.getElementById('order-id').value;
    const supplierName = document.getElementById('order-supplierName').value.trim();
    const orderDate = document.getElementById('order-orderDate').value;
    const expectedDeliveryDate = document.getElementById('order-expectedDeliveryDate').value;
    const status = document.getElementById('order-status').value;
    const amount = parseFloat(document.getElementById('order-amount').value) || 0;
    const notes = document.getElementById('order-notes').value.trim();

    if (!supplierName) {
      showToast('Por favor escriba el nombre del proveedor.', 'warning');
      return;
    }

    const btnSubmit = document.getElementById('btn-submit-order');
    btnSubmit.disabled = true;
    btnSubmit.innerText = 'Guardando...';

    const payload = {
      supplierName,
      orderDate,
      expectedDeliveryDate,
      status,
      amount,
      notes
    };

    try {
      const url = orderId ? `/purchases/orders/${orderId}/update` : '/purchases/orders';
      const resp = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const result = await resp.json();

      if (result.success) {
        showToast(result.message, 'success');
        closeOrderModal();
        setTimeout(() => {
          window.location.reload();
        }, 600);
      } else {
        showToast(result.message || 'Error al guardar.', 'error');
        btnSubmit.disabled = false;
        btnSubmit.innerText = orderId ? 'Actualizar Anotación' : 'Guardar Anotación';
      }
    } catch (err) {
      console.error(err);
      showToast('Error de conexión al guardar.', 'error');
      btnSubmit.disabled = false;
      btnSubmit.innerText = orderId ? 'Actualizar Anotación' : 'Guardar Anotación';
    }
  }

  async function toggleOrderStatus(orderId) {
    try {
      const resp = await fetch(`/purchases/orders/${orderId}/toggle-status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const result = await resp.json();
      if (result.success) {
        showToast(result.message, 'success');
        setTimeout(() => {
          window.location.reload();
        }, 500);
      } else {
        showToast(result.message || 'Error al cambiar estado.', 'error');
      }
    } catch (err) {
      console.error(err);
      showToast('Error al actualizar estado.', 'error');
    }
  }

  function confirmDeleteOrder(orderId) {
    showConfirm('¿Estás seguro de eliminar esta anotación de orden de compra?', async () => {
      try {
        const resp = await fetch(`/purchases/orders/${orderId}/delete`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const result = await resp.json();
        if (result.success) {
          showToast(result.message, 'success');
          setTimeout(() => {
            window.location.reload();
          }, 500);
        } else {
          showToast(result.message || 'Error al eliminar.', 'error');
        }
      } catch (err) {
        console.error(err);
        showToast('Error al eliminar anotación.', 'error');
      }
    });
  }

  function deleteCurrentOrder() {
    const orderId = document.getElementById('order-id').value;
    if (orderId) {
      closeOrderModal();
      confirmDeleteOrder(orderId);
    }
  }

  // --- LIST FILTERING ---
  function filterOrdersList() {
    const searchVal = document.getElementById('filter-search').value.toLowerCase().trim();
    const statusVal = document.getElementById('filter-status').value;
    const rows = document.querySelectorAll('.order-row');

    rows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const notes = row.getAttribute('data-notes') || '';
      const status = row.getAttribute('data-status') || '';

      const matchesSearch = !searchVal || name.includes(searchVal) || notes.includes(searchVal);
      const matchesStatus = statusVal === 'all' || status === statusVal;

      if (matchesSearch && matchesStatus) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });
  }

  // Initialize Calendar on load
  window.addEventListener('DOMContentLoaded', () => {
    renderCalendar();
  });
</script>

